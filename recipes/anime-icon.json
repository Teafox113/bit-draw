  "framing":{"type":"string","default":"face"},
  "threshold":{"type":"number","min":0.1,"max":0.9,"default":0.5}
 },
 "commands":[{"op":"image.pixelize","width":{"$param":"width"},"height":{"$param":"height"},"padding":2,"colors":{"$param":"colors"},"kind":"illustration","preset":"illustration","framing":{"$param":"framing"},"removeBackground":"anime","subjectThreshold":{"$param":"threshold"},"preserveFeatures":true,"featureMode":"crisp","finish":{"autoProtect":true,"kind":"illustration","restoreDetails":true,"detailMode":"crisp","despeckle":{"maxArea":2}}}]
}
